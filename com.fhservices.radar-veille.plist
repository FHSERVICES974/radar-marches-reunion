<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fhservices.radar-veille</string>

  <!-- Lance la veille via un shell de login pour disposer du PATH complet,
       active le venv, journalise dans veille.log. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "/Users/fhubert/Claude/radarartisans" &amp;&amp; ./run_veille.sh</string>
  </array>

  <!-- Chaque jour à 04:00 (pas de clé Weekday = tous les jours).
       Fréquence quotidienne pendant la phase de lancement du site (les appels
       à candidature arrivent au fil de l'eau) ; repasser à hebdomadaire
       (ajouter Weekday=1 pour lundi) une fois le rythme de croisière atteint. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Si le Mac dormait à 7h, la tâche se lance au réveil. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/fhubert/Claude/radarartisans/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/fhubert/Claude/radarartisans/launchd.err.log</string>
</dict>
</plist>
